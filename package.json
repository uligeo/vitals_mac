{
  "name": "mac-activity-tui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Interactive terminal dashboard with live charts for macOS activity.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uligeo/vitals_mac.git"
  },
  "bin": {
    "vitals": "dist/index.js"
  },
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "build": "tsc -p . && chmod +x dist/index.js",
    "prepare": "pnpm build",
    "start": "node --max-semi-space-size=1 --max-old-space-size=64 dist/index.js",
    "dev": "tsc -p . --watch --preserveWatchOutput",
    "check": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
